RewriteEngine On

# Přesměrování z verze www na bez www – kanonická doména je bez www
# (http→https přesměrování řeší hosting, sem se nedává).
RewriteCond %{HTTP_HOST} ^www\.raskaengineering\.cz$ [NC]
RewriteRule ^(.*)$ https://raskaengineering.cz/$1 [L,R=301]

# Přesměrování starých adres ze starého WordPress webu (301 = trvale, předá
# váhu stránky Googlu). Pravidla jsou před ostatními, ať jde o jediný skok.
# Podstránky průmyslu vedou na přehled průmyslových řešení, elektroinstalace
# na Elektro služby, zrušená plynová zařízení na úvodní stránku.
RewriteRule ^komplexni-servis-v-oblasti-prumyslu/elektroinstalace-a-elektrorevize/?$ https://raskaengineering.cz/elektro-sluzby [R=301,L]
RewriteRule ^komplexni-servis-v-oblasti-prumyslu(/.*)?$ https://raskaengineering.cz/prumyslova-reseni [R=301,L]
RewriteRule ^plynova-zarizeni/?$ https://raskaengineering.cz/ [R=301,L]
RewriteRule ^en/complex-services-in-the-field-of-industry/wiring-and-electrical-inspection/?$ https://raskaengineering.cz/en/electrical-services [R=301,L]
RewriteRule ^en/complex-services-in-the-field-of-industry(/.*)?$ https://raskaengineering.cz/en/industrial-solutions [R=301,L]
RewriteRule ^en/gas-devices/?$ https://raskaengineering.cz/en/ [R=301,L]

# Další staré adresy ze starého webu (zjištěné z webového archivu), aby
# nekončily na 404. Česká verze:
RewriteRule ^elektroinstalace-a-elektrorevize/?$ https://raskaengineering.cz/elektro-sluzby [R=301,L]
RewriteRule ^led-prumyslove-a-verejne-osvetleni/?$ https://raskaengineering.cz/elektro-sluzby [R=301,L]
RewriteRule ^protipozarni-ucpavky-hilti/?$ https://raskaengineering.cz/elektro-sluzby [R=301,L]
RewriteRule ^(cisteni-vodnich-a-chladicich-okruhu|cisteni-vodnich-a-chladicih-okruhu|elektromotory-do-100-kw-a-cerpadla|hydraulika-pneumatika|instalace-rozvodu-energii|instalace-rozvodu-materialu-a-energii|konzultace-a-poradenstvi|nastrojarstvi|prumyslove-instalace|stehovani-stroju-a-zarizeni|stehovani-stroju-a-zarizeni-eu-do-100-tun|stehovani-stroju-a-zarizeni-eu-do-40-tun|zamecnicke-prace)/?$ https://raskaengineering.cz/prumyslova-reseni [R=301,L]
RewriteRule ^(partneri|sitemap|tlumoceni)/?$ https://raskaengineering.cz/ [R=301,L]
# Anglická verze ze starého webu (/en/...):
RewriteRule ^en/elektroinstalace-a-elektrorevize/?$ https://raskaengineering.cz/en/electrical-services [R=301,L]
RewriteRule ^en/kontakt-2/?$ https://raskaengineering.cz/en/contact [R=301,L]
RewriteRule ^en/(cisteni-vodnich-a-chladicih-okruhu-en|instalace-rozvodu-materialu-a-energii-en|konzultace-a-poradenstvi-en|nastrojarstvi-en|prumyslove-instalace-en|stehovani-stroju-a-zarizeni-en)/?$ https://raskaengineering.cz/en/industrial-solutions [R=301,L]
# Staré jazykové verze /gbr/ (angličtina) a /esp/ (španělština) vedou na anglický web:
RewriteRule ^(gbr|esp)/(contact|contactos)/?$ https://raskaengineering.cz/en/contact [R=301,L]
RewriteRule ^(gbr/wiring-and-electrical-inspection|esp/instalaciones-y-revisiones-electricas)/?$ https://raskaengineering.cz/en/electrical-services [R=301,L]
RewriteRule ^(gbr|esp)/(interpretation|interpretacion|sitemap)/?$ https://raskaengineering.cz/en/ [R=301,L]
RewriteRule ^(gbr|esp)/.+$ https://raskaengineering.cz/en/industrial-solutions [R=301,L]
RewriteRule ^(gbr|esp)/?$ https://raskaengineering.cz/en/ [R=301,L]
# Anglické adresy starého webu s /en/ i bez něj (Google je má v indexu):
RewriteRule ^photovoltaics/?$ https://raskaengineering.cz/en/photovoltaics [R=301,L]
RewriteRule ^contact/?$ https://raskaengineering.cz/en/contact [R=301,L]
RewriteRule ^gas-devices/?$ https://raskaengineering.cz/en/ [R=301,L]
RewriteRule ^(en/)?wiring-and-electrical-inspection/?$ https://raskaengineering.cz/en/electrical-services [R=301,L]
RewriteRule ^(en/)?(complex-services-in-the-field-of-industry(/.*)?|industrial-installations|consultations-and-advice|cleaning-of-water-and-cooling-circuits|production-and-repair-of-heating-systems|installation-of-materials-and-energy-distribution|moving-machinery-and-equipment.*)/?$ https://raskaengineering.cz/en/industrial-solutions [R=301,L]
RewriteRule ^vyroba-a-oprava-topnych-teles/?$ https://raskaengineering.cz/prumyslova-reseni [R=301,L]

# Stará adresa s lomítkem na konci (/kontakt/, /fotovoltaika/, /en/contact/)
# vede na stejnou adresu bez lomítka. Skutečné složky (/en/) se nemění.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://raskaengineering.cz/$1 [R=301,L]

# Kdyby si někdo otevřel adresu s .html (např. /elektro-sluzby.html),
# přesměruj ho na hezkou adresu bez přípony (/elektro-sluzby).
RewriteCond %{THE_REQUEST} /([^.\s]+)\.html[\s?] [NC]
RewriteRule ^ https://raskaengineering.cz/%1 [NC,L,R=301]

# Adresu bez přípony (např. /elektro-sluzby) interně napoj na skutečný
# soubor (elektro-sluzby.html), aniž by se to projevilo v adresním řádku.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]

# Vlastní chybová stránka pro neexistující adresy.
ErrorDocument 404 /404.html

# Interní pracovní poznámky (stav.md, instrukce.md) nejsou určené pro
# veřejnost – kdyby se omylem nahrály na hosting spolu s webem, tohle
# zajistí, že přes prohlížeč nepůjdou stáhnout.
<FilesMatch "\.md$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Bezpečnostní hlavičky.
<IfModule mod_headers.c>
  # Web nelze vložit do cizího iframu (ochrana před clickjackingem).
  Header always set X-Frame-Options "SAMEORIGIN"
  # Prohlížeč nebude hádat typ souboru podle obsahu.
  Header always set X-Content-Type-Options "nosniff"
  # Po prvním HTTPS spojení prohlížeč vždy použije jen HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Při přechodu na jiný web se odesílá jen doména, ne celá URL.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Web mikrofon, kameru ani geolokaci nepoužívá.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Cache statických souborů v prohlížeči (PageSpeed: "efektivní cache").
# CSS a JS mají v HTML číslo verze (?v=...), takže po změně se načtou nové;
# obrázky nemají, proto jen měsíc. HTML se necachuje, aby se změny projevily hned.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
